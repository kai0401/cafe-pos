<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cafe-pos</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /path/to/cafe-pos &amp;&amp; npm run start:shop</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/cafe-pos.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cafe-pos.err</string>
  <key>WorkingDirectory</key>
  <string>/path/to/cafe-pos</string>
</dict>
</plist>
