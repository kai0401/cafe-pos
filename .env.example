# --- 本番（Vercel + Neon）店舗 Mac 不要 ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# 固定公開URL（QRシール印刷前に必ず設定）
PUBLIC_BASE_URL="https://your-app.vercel.app"

# クラウド公開時のスタッフ画面PIN（4文字以上）
# STAFF_ACCESS_PIN="956313"

# 遠隔モニター心拍（Pi → クラウド）
# OPS_HEARTBEAT_KEY="長いランダム文字列"
# Pi側のみ: OPS_CLOUD_URL="https://azumaya-pos.vercel.app"

# STORES決済（請求書決済API / Coiney API キー・任意）
# STORES_API_KEY="your-api-key"

# レシートAI画像解析（OpenAI Vision・推奨）
# OPENAI_API_KEY="sk-..."
# OPENAI_VISION_MODEL="gpt-4o-mini"

# --- オーナー手元の開発用のみ（店舗には不要）---
# DATABASE_URL="postgresql://...localhost..."
# PORT=3000
