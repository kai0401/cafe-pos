# --- 本番（Vercel + Neon）店舗 Mac 不要 ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# 固定公開URL（QRシール印刷前に必ず設定）
PUBLIC_BASE_URL="https://your-app.vercel.app"

# 管理画面PIN（本番必須）
ADMIN_PIN="0000"

# スタッフPIN（ウェイター・キッチン操作・本番必須）
STAFF_PIN="0000"

# STORES決済（請求書決済API / Coiney API キー・任意）
# STORES_API_KEY="your-api-key"

# レシートAI画像解析（OpenAI Vision・推奨）
# OPENAI_API_KEY="sk-..."
# OPENAI_VISION_MODEL="gpt-4o-mini"

# --- ローカル開発のみ（手元の Mac）---
# DATABASE_URL="file:./prisma/dev.db"

# PORT=3000
